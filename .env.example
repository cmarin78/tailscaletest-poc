# tailscaletest-poc — environment template
# Copy this file to `.env` and paste real values from the Tailscale admin console.
# Every key is generated in: admin.tailscale.com → Settings → Keys → Generate auth key
# Each one is pre-tagged (not --advertise-tags). Reusable = true is convenient for POC.
# They live only in this file on disk — never paste them into git, README, or any shared doc.

TS_AUTHKEY_ADMIN_PORTAL=tskey-auth-REPLACE-ME-tag-admin-portal
TS_AUTHKEY_INTERNAL_DB=tskey-auth-REPLACE-ME-tag-internal-db
TS_AUTHKEY_ENG_ADMIN=tskey-auth-REPLACE-ME-tag-eng-admin
TS_AUTHKEY_UNTRUSTED=tskey-auth-REPLACE-ME-tag-untrusted